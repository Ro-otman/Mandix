    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-static-gzip": "^3.0.2",
    "express-validator": "7.3.2",
