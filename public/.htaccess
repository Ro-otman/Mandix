# Fichiers statiques servis directement par le serveur web de l'hébergeur (Hostinger, LiteSpeed), sans passer par
# l'application : sans ces règles, aucun en-tête Cache-Control n'était envoyé, et les navigateurs redemandaient
# feuilles de style, scripts, polices et images à chaque page (très lent sur une connexion lointaine).
# Aucune réécriture d'adresse ici : uniquement des en-têtes.

<IfModule mod_headers.c>
  # Fichiers construits avec une empreinte de contenu (dist/css/app.3f2a1c9d.css) : jamais modifiés, cache d'un an.
  <FilesMatch "\.[0-9a-f]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Polices (noms stables, contenu inchangé) : un an, comme dans app.js.
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images, logos, drapeaux : 7 jours, puis mise à jour discrète en arrière-plan.
  <FilesMatch "\.(svg|png|jpe?g|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  # Fichiers sans empreinte qui changent à chaque construction : courte durée.
  <FilesMatch "^(manifest\.json|robots\.txt)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>

  # Protection habituellement ajoutée par l'application (helmet), absente sur ces fichiers.
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
