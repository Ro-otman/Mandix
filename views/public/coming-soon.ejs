<section class="status-page">
  <div class="container status-page__grid">
    <div class="status-page__art" data-hero-item>
      <img src="/images/illustrations/en-construction.svg" alt="" width="480" height="360">
    </div>
    <div class="status-page__text" data-hero-item>
      <p class="status-page__code status-page__code--soon">Bientôt disponible</p>
      <h1 class="status-page__title"><%= title %></h1>
      <p class="status-page__message">Cette page est en cours de conception. Elle arrive très prochainement.</p>
      <div class="cluster status-page__actions">
        <a class="btn btn--primary btn--lg" href="/mandataires"><%- icon('search', { size: 18 }) %> Trouver un mandataire</a>
        <a class="btn btn--ghost-border btn--lg" href="/"><%- icon('arrow-left', { size: 18 }) %> Retour à l'accueil</a>
      </div>
    </div>
  </div>
</section>
