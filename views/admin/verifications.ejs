<%#
  Vérifications de mandataires demandées par les clients (« Faire vérifier ce mandataire »), au 2e rejet de la preuve
  ou après 7 jours d'attente. Les preuves jointes à chaque rejet (vues par le client) sont affichées avec la demande. Le mandataire est restreint et envoie les preuves du refus sous 72 h.
  Refus justifié : la restriction est levée. Refus non justifié : restriction de 100 jours (appliquée aussi,
  automatiquement, si aucune preuve n'arrive sous 72 h). Dans tous les cas, la transaction est close (rejetée).
  Locaux : requests (services/adminService.js → listVerifications), pendingMaxDays.
  La décision est publiée dans la conversation (message « Équipe Mandix ») et notifiée au client et au mandataire.
%>
<%
  const STATES = {
    open: { label: 'À décider', tone: 'warning', icon: 'clock' },
    authentic: { label: 'Refus justifié', tone: 'success', icon: 'circle-check' },
    not_authentic: { label: 'Refus non justifié · 100 jours', tone: 'danger', icon: 'circle-x' },
  };
  const daysSince = (d) => Math.max(0, Math.floor((Date.now() - new Date(d).getTime()) / 864e5));
  const open = requests.filter((r) => r.status === 'open').length;
%>
<%- include('../partials/dash/page-head', { heading: 'Vérifications', sub: 'Mandataires que des clients font vérifier : examinez les preuves du refus. Refus justifié : la restriction est levée ; non justifié : compte restreint 100 jours.' }) %>

<p class="verif-count"><strong data-verif-open><%= open %></strong> demande<%= open > 1 ? 's' : '' %> à traiter</p>

<div class="verif-list" data-verif-list>
  <% requests.forEach((r) => { const st = STATES[r.status]; %>
    <article class="verif-card <%= r.status === 'open' ? 'is-open' : '' %>" data-verif-card data-ref="<%= r.ref %>" data-client="<%= r.client %>">
      <header class="verif-card__head">
        <span class="verif-card__ref mono"><%= r.ref %></span>
        <span class="badge badge--<%= st.tone %>" data-verif-status><%- icon(st.icon, { size: 13 }) %> <%= st.label %></span>
      </header>
      <div class="verif-card__parties">
        <p><span class="verif-card__role">Client</span><strong><%= r.client %></strong></p>
        <span class="verif-card__arrow" aria-hidden="true"><%- icon('arrow-right', { size: 16 }) %></span>
        <p><span class="verif-card__role">Mandataire</span><a href="/admin/mandataires/<%= r.slug %>"><strong><%= r.pro %></strong></a></p>
      </div>
      <dl class="verif-card__facts">
        <div><dt>Compte</dt><dd><span class="stats-account"><%- serviceLogo(r.type, { size: 18 }) %> <%= r.account %></span></dd></div>
        <div><dt>Montant</dt><dd><%= r.amount %></dd></div>
        <div><dt>Preuves rejetées</dt><dd><%= r.rejections %></dd></div>
        <div><dt>Vérification demandée</dt><dd><%= fmt.formatDateTime(r.requestedAt) %></dd></div>
        <% if (r.status === 'open' && r.evidenceDueAt) { %><div><dt>Preuves attendues avant</dt><dd><%= fmt.formatDateTime(r.evidenceDueAt) %></dd></div><% } %>
      </dl>
      <% if (r.rejectionProofs.length) { %>
        <div class="verif-card__evidence">
          <p class="verif-card__role">Preuves jointes aux rejets (vues par le client)</p>
          <ul class="verif-files">
            <% r.rejectionProofs.forEach((f) => { %>
              <li>
                <% if (f.preview) { %>
                  <a class="verif-file verif-file--image" href="<%= f.preview %>?espace=admin" target="_blank" rel="noopener"><img src="<%= f.preview %>?espace=admin" alt="Preuve du rejet : <%= f.name %>" loading="lazy"><span><%= f.name %></span></a>
                <% } else { %>
                  <a class="verif-file" href="<%= f.url %>?espace=admin" target="_blank" rel="noopener"><%- icon('file-text', { size: 20 }) %><span><%= f.name %><% if (f.size) { %> · <%= Math.round(f.size / 1024) %> Ko<% } %></span></a>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <div class="verif-card__evidence">
        <p class="verif-card__role">Preuves du refus envoyées par le mandataire</p>
        <% if (!r.evidence.length) { %>
          <p class="text-muted"><%= r.status === 'open' ? 'En attente des preuves du mandataire. Sans preuve dans les 72 heures, la restriction de 100 jours s’applique automatiquement.' : (r.note || 'Aucune preuve envoyée.') %></p>
        <% } %>
        <ul class="verif-files">
          <% r.evidence.forEach((f) => { %>
            <li>
              <%# ?espace=admin : session administrateur, même si le navigateur a aussi une session client ou mandataire %>
              <% if (f.preview) { %>
                <a class="verif-file verif-file--image" href="<%= f.preview %>?espace=admin" target="_blank" rel="noopener"><img src="<%= f.preview %>?espace=admin" alt="Preuve : <%= f.name %>" loading="lazy"><span><%= f.name %></span></a>
              <% } else { %>
                <a class="verif-file" href="<%= f.url %>?espace=admin" target="_blank" rel="noopener"><%- icon('file-text', { size: 20 }) %><span><%= f.name %><% if (f.size) { %> · <%= Math.round(f.size / 1024) %> Ko<% } %></span></a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
      <footer class="verif-card__foot" data-verif-actions <%= r.status === 'open' && r.evidence.length ? '' : 'hidden' %>>
        <form method="post" action="/admin/verifications/<%= r.ref %>/decision" data-confirm="Le refus de <%= r.pro %> est justifié : sa restriction est levée. La transaction est close, <%= r.client %> est invité à l'évaluer." data-confirm-title="Confirmer : refus justifié" data-confirm-label="Confirmer">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="decision" value="justified">
          <button class="btn btn--success" type="submit"><%- icon('circle-check', { size: 16 }) %> Refus justifié : lever la restriction</button>
        </form>
        <form method="post" action="/admin/verifications/<%= r.ref %>/decision" data-confirm="Le refus de <%= r.pro %> n'est pas justifié : son compte est restreint pendant 100 jours (plus d'ajout de compte, niveau bloqué). La transaction est close." data-confirm-title="Confirmer : refus non justifié" data-confirm-label="Confirmer" data-confirm-tone="danger">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="decision" value="unjustified">
          <button class="btn btn--danger" type="submit"><%- icon('circle-x', { size: 16 }) %> Refus non justifié : restreindre 100 jours</button>
        </form>
      </footer>
      <% if (r.decidedAt) { %><p class="verif-card__decided">Décision du <%= fmt.formatDateTime(r.decidedAt) %> · client notifié</p><% } %>
    </article>
  <% }) %>
</div>

<%# Modèle d'une demande faite en direct dans la messagerie de démonstration %>



