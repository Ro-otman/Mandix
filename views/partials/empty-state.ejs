<%#
  État vide illustré.
  Locaux : emptyTitle, emptyText, emptyIllustration ('search' | 'reviews'), emptyAction ({ href, label }) optionnel.
%>
<div class="empty-state">
  <img class="empty-state__illustration" src="/images/empty-<%= typeof emptyIllustration !== 'undefined' ? emptyIllustration : 'search' %>.svg" alt="" width="120" height="105">
  <h3 class="empty-state__title"><%= emptyTitle %></h3>
  <p><%= emptyText %></p>
  <% if (typeof emptyAction !== 'undefined' && emptyAction) { %>
    <a class="btn btn--secondary" href="<%= emptyAction.href %>"><%= emptyAction.label %></a>
  <% } %>
</div>
