<%# Indicateur. Locaux : statLabel, statValue, statIcon, statHint (facultatif), statTone ('blue' | 'green' | 'gold' | 'red'), statHref (facultatif). %>
<% const tone = typeof statTone !== 'undefined' ? statTone : 'blue'; const href = typeof statHref !== 'undefined' ? statHref : null; %>
<<%= href ? 'a' : 'div' %> class="kpi kpi--<%= tone %>" <%- href ? `href="${href}"` : '' %>>
  <span class="kpi__icon"><%- icon(statIcon, { size: 20, strokeWidth: 1.9 }) %></span>
  <span class="kpi__label"><%= statLabel %></span>
  <span class="kpi__value"><%= statValue %></span>
  <% if (typeof statHint !== 'undefined' && statHint) { %><span class="kpi__hint"><%= statHint %></span><% } %>
</<%= href ? 'a' : 'div' %>>
