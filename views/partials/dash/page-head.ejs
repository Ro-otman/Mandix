<%# En-tête de page d'espace. Locaux : heading, sub (facultatif), actions [{ href, label, icon, variant, demo }] (facultatif). %>
<div class="page-header">
  <div>
    <h1><%= heading %></h1>
    <% if (typeof sub !== 'undefined' && sub) { %><p><%= sub %></p><% } %>
  </div>
  <% if (typeof actions !== 'undefined' && actions && actions.length) { %>
    <div class="cluster">
      <% actions.forEach((a) => { %>
        <a class="btn <%= a.variant || 'btn--primary' %>" href="<%= a.href %>"><% if (a.icon) { %><%- icon(a.icon, { size: 17 }) %><% } %> <%= a.label %></a>
      <% }) %>
    </div>
  <% } %>
</div>
