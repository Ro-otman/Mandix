<%#
  Bouton « son des notifications » (public/js/sound.js) : activé par défaut, choix mémorisé sur cet appareil.
  Libellé et état mis à jour par le script.
%>
<button class="theme-toggle sound-toggle" type="button" data-sound-toggle aria-pressed="false" aria-label="Couper le son des notifications" title="Son des notifications activé">
  <span class="sound-toggle__icon sound-toggle__icon--on"><%- icon('volume-2', { size: 18 }) %></span>
  <span class="sound-toggle__icon sound-toggle__icon--off"><%- icon('volume-x', { size: 18 }) %></span>
</button>
