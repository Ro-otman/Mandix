<%#
  Barre de recherche des mandataires, dans l'ordre : compte, pays, montant, mandataire.
  Locaux : action (URL du formulaire), filters, countries, accountTypes,
           idPrefix (unicité des id), keep (facultatif : autres filtres à conserver en champs cachés).
  Les listes « Compte » et « Pays » sont enrichies (logos, drapeaux ; recherche dans les pays) par public/js/rich-select.js ;
  sans JavaScript, les listes natives restent utilisables.
  Le montant garde les mandataires dont le plafond couvre cette somme (en euros).
%>
<% const carry = typeof keep !== 'undefined' ? keep : []; %>
<form class="sbar" action="<%= action %>" method="get" role="search" aria-label="Rechercher un mandataire">
  <div class="sbar__field">
    <label class="sbar__label" for="<%= idPrefix %>-type">Compte</label>
    <div class="sbar__control">
      <%- icon('wallet', { size: 17 }) %>
      <select class="sbar__input" id="<%= idPrefix %>-type" name="type" data-rich-select>
        <option value="">Tous les comptes</option>
        <% accountTypes.forEach((t) => { %><option value="<%= t.slug %>" data-icon="<%= t.logo %>" <%= filters.type === t.slug ? 'selected' : '' %>><%= t.name %></option><% }) %>
      </select>
    </div>
  </div>

  <div class="sbar__field">
    <label class="sbar__label" for="<%= idPrefix %>-pays">Pays</label>
    <div class="sbar__control">
      <%- icon('globe', { size: 17 }) %>
      <select class="sbar__input" id="<%= idPrefix %>-pays" name="pays" data-rich-select data-rich-select-flags data-rich-select-search="Rechercher un pays">
        <option value="">Tous les pays</option>
        <% countries.forEach((c) => { %><option value="<%= c.code %>" data-icon="/images/flags/<%= c.code.toLowerCase() %>.svg" <%= filters.pays === c.code ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
    </div>
  </div>

  <div class="sbar__field sbar__field--amount">
    <label class="sbar__label" for="<%= idPrefix %>-somme">Montant</label>
    <div class="sbar__control">
      <%- icon('banknote', { size: 17 }) %>
      <input class="sbar__input" id="<%= idPrefix %>-somme" type="number" name="somme" value="<%= filters.somme %>" placeholder="Ex. 500" min="1" max="999999999" step="1" inputmode="numeric" aria-describedby="<%= idPrefix %>-somme-unit">
      <span class="sbar__unit" id="<%= idPrefix %>-somme-unit">€</span>
    </div>
  </div>

  <div class="sbar__field sbar__field--name">
    <label class="sbar__label" for="<%= idPrefix %>-nom">Mandataire</label>
    <div class="sbar__control">
      <%- icon('search', { size: 17 }) %>
      <input class="sbar__input" id="<%= idPrefix %>-nom" type="search" name="nom" value="<%= filters.nom %>" placeholder="Nom du mandataire" maxlength="60" autocomplete="off" spellcheck="false">
    </div>
  </div>

  <% carry.forEach((k) => { if (filters[k] && !(k === 'tri' && filters[k] === 'pertinence')) { %><input type="hidden" name="<%= k %>" value="<%= filters[k] %>"><% } }) %>
  <button class="btn btn--primary sbar__submit" type="submit"><%- icon('search', { size: 18 }) %><span>Rechercher</span></button>
</form>
<script src="<%= asset('js/rich-select.js') %>" defer></script>
