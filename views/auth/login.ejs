<%#
  Connexion, en deux onglets qui font réellement la différence :
    - « Client » n'accepte que les comptes clients, « Professionnel » que les comptes mandataires
      (les administrateurs passent par l'un ou l'autre). Un compte de l'autre type est refusé par le serveur
      (authService.login, paramètre space) sans ouvrir de session.
    - Le changement d'onglet est instantané (public/js/auth.js) : titre, couleur du bouton, lien d'inscription,
      champ caché « espace » et adresse de la page. Sans JavaScript, les onglets sont de simples liens.
  Locaux : errors, values, formError, unverified (adresse non confirmée), nextPath (page à rouvrir),
  proSpace (onglet Professionnel), openSpaces (espaces déjà connectés dans ce navigateur : une session par espace,
  leur onglet mène directement à l'espace au lieu d'afficher le formulaire).
%>
<%
  const err = (k) => errors && errors[k];
  const space = proSpace ? 'mandataire' : 'client';
  const shown = (s) => (s === space ? '' : 'hidden');
  const SPACE_HOME = { client: '/client/dashboard', mandataire: '/mandataire/comptes' };
  const open = (s) => (typeof openSpaces !== 'undefined' ? openSpaces : []).includes(s);
%>
<div class="auth-card" data-login-space="<%= space %>">
  <h1 class="auth-title" data-space-show="client" <%= shown('client') %>>Bon retour <span class="auth-hl">parmi nous</span></h1>
  <h1 class="auth-title" data-space-show="mandataire" <%= shown('mandataire') %>>Votre espace <span class="auth-hl">mandataire</span></h1>

  <div class="role-switch" role="tablist" aria-label="Type de compte">
    <% [['client', 'user-round', 'Client', '/connexion'], ['mandataire', 'briefcase-business', 'Professionnel', '/connexion?espace=mandataire']].forEach(([s, ic, label, href]) => { %>
      <% if (open(s)) { %>
        <%# Déjà connecté à cet espace dans ce navigateur : l'onglet y mène directement. %>
        <a class="role-switch__item" href="<%= SPACE_HOME[s] %>" role="tab" aria-selected="false" data-role-tab="<%= s %>" data-role-tab-nav>
          <%- icon(ic, { size: 17 }) %> <%= label %>
        </a>
      <% } else { %>
        <a class="role-switch__item<%= space === s ? ' is-active' : '' %>" href="<%= href %>" role="tab" aria-selected="<%= space === s %>" data-role-tab="<%= s %>">
          <%- icon(ic, { size: 17 }) %> <%= label %>
        </a>
      <% } %>
    <% }) %>
  </div>

  <%- include('../partials/form-alert', { formError }) %>
  <% if (typeof unverified !== 'undefined' && unverified) { %>
    <form class="form-alert__action" method="post" action="/verification-email/renvoyer">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn--ghost-border btn--block" type="submit" data-busy-label="Envoi du lien…"><%- icon('send', { size: 17 }) %> Renvoyer le lien de confirmation</button>
    </form>
  <% } %>

  <form class="auth-form" method="post" action="/connexion" data-auth-login>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (nextPath) { %><input type="hidden" name="suite" value="<%= nextPath %>"><% } %>
    <input type="hidden" name="espace" value="<%= space %>" data-space-input>

    <div class="field">
      <label class="field__label" for="email">Adresse e-mail</label>
      <div class="input-group">
        <%- icon('mail', { size: 18 }) %>
        <input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="191" placeholder="nom@exemple.com"
               value="<%= values.email || '' %>" <%- err('email') ? 'aria-invalid="true" aria-describedby="email-error"' : '' %>>
      </div>
      <%- include('../partials/field-error', { id: 'email-error', message: err('email') }) %>
    </div>

    <div class="field">
      <div class="field__row">
        <label class="field__label" for="password">Mot de passe</label>
        <a class="field__link" href="/mot-de-passe-oublie">Mot de passe oublié ?</a>
      </div>
      <div class="input-group input-group--action">
        <%- icon('lock', { size: 18 }) %>
        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required maxlength="128"
               <%- err('password') ? 'aria-invalid="true" aria-describedby="password-error"' : '' %>>
        <button class="input-action" type="button" data-password-toggle="password" aria-label="Afficher le mot de passe" aria-pressed="false"><%- icon('eye', { size: 18 }) %></button>
      </div>
      <%- include('../partials/field-error', { id: 'password-error', message: err('password') }) %>
    </div>

    <label class="checkbox"><input type="checkbox" name="remember"> <span>Rester connecté sur cet appareil (30 jours)</span></label>

    <button class="btn <%= space === 'mandataire' ? 'btn--gold' : 'btn--primary' %> btn--lg btn--block auth-submit" type="submit" data-busy-label="Connexion…">
      Se connecter <%- icon('arrow-right', { size: 18 }) %>
    </button>
  </form>

  <div class="auth-divider" data-space-show="client" <%= shown('client') %>><span>Nouveau sur <%= appName %> ?</span></div>
  <div class="auth-alt" data-space-show="client" <%= shown('client') %>>
    <a class="auth-alt__item" href="/inscription">
      <span class="auth-alt__icon auth-alt__icon--blue"><%- icon('user-plus', { size: 18 }) %></span>
      <span><strong>Créer un compte</strong><small>Compte client</small></span>
    </a>
  </div>

  <div class="auth-divider" data-space-show="mandataire" <%= shown('mandataire') %>><span>Pas encore de compte mandataire ?</span></div>
  <div class="auth-alt" data-space-show="mandataire" <%= shown('mandataire') %>>
    <a class="auth-alt__item auth-alt__item--pro" href="/mandataire/inscription">
      <span class="auth-alt__icon auth-alt__icon--gold"><%- icon('briefcase-business', { size: 18 }) %></span>
      <span><strong>Devenir prestataire</strong><small>Compte professionnel</small></span>
    </a>
  </div>
</div>
