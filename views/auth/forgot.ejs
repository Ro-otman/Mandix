<%#
  Mot de passe oublié. Locaux : errors, values, sent (demande envoyée), maskedEmail.
  Même réponse qu'un compte existe ou non pour l'adresse indiquée.
%>
<% const err = (k) => errors && errors[k]; const isSent = typeof sent !== 'undefined' && sent; %>
<div class="auth-card">
  <span class="auth-badge" aria-hidden="true"><%- icon(isSent ? 'mail-check' : 'key-round', { size: 22 }) %></span>
  <% if (isSent) { %>
    <h1 class="auth-title">Vérifiez vos <span class="auth-hl">e-mails</span></h1>
    <%- include('../partials/form-alert', { alertType: 'success', formTitle: 'Lien envoyé', formError: `Si un compte existe pour ${maskedEmail}, un lien valable 30 minutes vient de partir.` }) %>
    <p class="auth-switch"><a href="/mot-de-passe-oublie"><%- icon('rotate-ccw', { size: 15 }) %> Renvoyer un lien</a></p>
  <% } else { %>
    <h1 class="auth-title">Mot de passe <span class="auth-hl">oublié ?</span></h1>
    <p class="auth-sub">Entrez votre e-mail, nous vous envoyons un lien.</p>
    <form class="auth-form" method="post" action="/mot-de-passe-oublie">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="field__label" for="email">Adresse e-mail</label>
        <div class="input-group"><%- icon('mail', { size: 18 }) %><input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="191" placeholder="nom@exemple.com" value="<%= values.email || '' %>" <%- err('email') ? 'aria-invalid="true" aria-describedby="email-error"' : '' %>></div>
        <%- include('../partials/field-error', { id: 'email-error', message: err('email') }) %>
      </div>
      <button class="btn btn--primary btn--lg btn--block" type="submit" data-busy-label="Envoi du lien…"><%- icon('send', { size: 18 }) %> Envoyer le lien</button>
    </form>
  <% } %>
  <p class="auth-switch"><a href="/connexion"><%- icon('arrow-left', { size: 15 }) %> Retour à la connexion</a></p>
</div>
