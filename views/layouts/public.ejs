<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/document-head', { styles: ['public', ...(typeof extraStyles !== 'undefined' ? extraStyles : [])] }) %>
</head>
<body>
  <%- include('../partials/loader') %>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <div class="page">
    <%- include('../partials/navbar') %>
    <main id="contenu" tabindex="-1">
      <%- body %>
    </main>
    <%- include('../partials/footer') %>
  </div>
  <%- include('../partials/toasts') %>
  <%- include('../partials/confirm-dialog') %>
  <% if (typeof publicDrawer !== 'undefined' && publicDrawer) { %><%- include('../partials/dash/drawer', { drawerBase: '' }) %><% } %>
  <%- include('../partials/scripts') %>
  <% if (typeof publicDrawer !== 'undefined' && publicDrawer) { %><script src="<%= asset('js/drawer.js') %>" defer></script><% } %>
</body>
</html>
