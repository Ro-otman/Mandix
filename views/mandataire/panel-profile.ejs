<%# Fragment chargé dans le panneau latéral (public/js/drawer.js) : profil du mandataire. Locaux : pro, countries, certificationThreshold. %>
<div class="drawer-view drawer-view--myprofile" data-drawer-view="myprofile">
  <div class="msheet__bar">
    <button class="btn btn--ghost btn--icon drawer__back" type="button" data-drawer-back aria-label="Retour" hidden><%- icon('arrow-left', { size: 20 }) %></button>
    <h2 class="msheet__bar-title proprof__title" id="drawer-title">Mon profil</h2>
    <a class="btn btn--ghost btn--icon" href="/mandataire/profil" data-drawer-native aria-label="Ouvrir la page Mon profil" title="Ouvrir en pleine page"><%- icon('maximize-2', { size: 18 }) %></a>
    <button class="btn btn--ghost btn--icon drawer__close" type="button" data-drawer-close aria-label="Fermer le profil"><%- icon('x', { size: 20 }) %></button>
  </div>

  <form class="proprof" method="post" action="/mandataire/profil">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="proprof__scroll">
      <section class="proprof__summary">
        <%- include('../partials/dash/pro-profile-card', { pro, certificationThreshold, compact: true }) %>
        <a class="btn btn--ghost-border proprof__preview" href="/mandataire/apercu"><%- icon('eye', { size: 17 }) %> Voir ma page publique</a>
      </section>
      <section class="proprof__section">
        <h3>Présentation et localisation</h3>
        <%- include('../partials/dash/pro-profile-fields', { pro, countries, idPrefix: 'ppr' }) %>
      </section>
    </div>
    <footer class="msheet__actions">
      <button class="btn btn--primary btn--lg msheet__message" type="submit"><%- icon('check', { size: 18 }) %> Enregistrer</button>
    </footer>
  </form>
</div>
