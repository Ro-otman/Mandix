NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# true uniquement derrière un reverse proxy (Nginx, Render, etc.)
TRUST_PROXY=false

# MySQL 8.0.16+
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mandix
DB_POOL_SIZE=10

# Authentification par jetons (jeton d'accès JWT + jeton de rafraîchissement, en cookies HttpOnly).
# Trois secrets DIFFÉRENTS, d'au moins 32 octets, à générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
COOKIE_SECRET=
CSRF_SECRET=
# Durées : jeton d'accès (minutes), session « Rester connecté » (jours), session simple (heures)
# Chiffrement des messages, coordonnées de réception et fichiers joints (AES-256-GCM), 32 octets en base64 :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# À sauvegarder en lieu sûr : sans elle, les données chiffrées sont perdues.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_REMEMBER_DAYS=30
REFRESH_SESSION_HOURS=12

# Profils de démonstration (design uniquement, ignoré en production)
DEMO_CONTENT=true

# Téléversements
UPLOAD_MAX_MB=5

# SMTP (laisser vide en développement : les e-mails sont alors enregistrés dans storage/mail-outbox, voir /dev/emails)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=l'adresse Gmail,
#         SMTP_PASS=un « mot de passe d'application » (16 caractères, https://myaccount.google.com/apppasswords),
#         jamais le mot de passe du compte. EMAIL_FROM doit utiliser la même adresse.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Mandix <no-reply@votredomaine.bj>"
